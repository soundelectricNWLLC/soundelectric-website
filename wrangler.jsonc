// Cloudflare Worker (static assets only) serving https://soundelectric.com
// Build first:  npm run build   (output: ./dist)
// Upload:       npx wrangler versions upload   (creates a version + preview URL, NOT live)
// Go live:      npx wrangler versions deploy <version-id>@100%
// Rollback:     npx wrangler rollback <previous-version-id>
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soundelectric",
  "account_id": "e9bfbeddc7a23de46c29c8059df73eda",
  "compatibility_date": "2026-09-01",
  // No "main": this is an assets-only Worker. No /api/contact endpoint.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
    // html_handling: default ("auto-trailing-slash"), matches Astro's directory output and trailing-slash canonicals
  },
  // Keep the workers.dev URL and preview URLs as they are today (both enabled; noindex is set in public/_headers).
  "workers_dev": true,
  "preview_urls": true,
  // The production route is declared explicitly so a plain `wrangler deploy` never drops it.
  // DNS stays as-is: apex CNAME (proxied) + www CNAME (proxied, 301 to apex via zone rules).
  "routes": [
    { "pattern": "soundelectric.com/*", "zone_name": "soundelectric.com" }
  ],
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
