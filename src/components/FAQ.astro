---
import { FAQS } from '../data/site';
---
<div class="divide-y divide-white/[0.07] rounded-2xl border border-white/[0.08] bg-white/[0.02]">
  {FAQS.map((f, i) => (
    <details class="group px-6 py-1 sm:px-8" open={i === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-base font-semibold text-white transition hover:text-volt-300 sm:text-lg">
        {f.q}
        <span class="faq-icon grid h-8 w-8 shrink-0 place-items-center rounded-full border border-white/15 text-volt-400 transition-transform duration-300">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </span>
      </summary>
      <p class="max-w-3xl pb-6 leading-relaxed text-slate-400">{f.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
})} />
