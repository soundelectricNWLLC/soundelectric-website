---
interface Props { eyebrow: string; title: string; lead?: string; }
const { eyebrow, title, lead } = Astro.props;
---
<section class="relative overflow-hidden border-b border-white/[0.06]">
  <div class="navy-glow absolute inset-0"></div>
  <div class="bg-grid mask-radial absolute inset-0"></div>
  <div class="absolute left-1/2 top-10 h-72 w-[46rem] -translate-x-1/2 rounded-full bg-night-600/40 blur-3xl"></div>
  <div class="container-x relative pb-20 pt-36 sm:pb-28 sm:pt-44">
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="mt-5 max-w-4xl text-4xl leading-[1.02] sm:text-6xl lg:text-7xl" set:html={title} />
    {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">{lead}</p>}
    <slot />
  </div>
</section>
