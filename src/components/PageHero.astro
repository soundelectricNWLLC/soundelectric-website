---
interface Props { eyebrow: string; title: string; lead?: string; }
const { eyebrow, title, lead } = Astro.props;
---
<section class="relative overflow-hidden border-b border-white/[0.06]">
  <div class="bg-grid mask-radial absolute inset-0"></div>
  <div class="absolute left-1/2 top-0 h-72 w-[46rem] -translate-x-1/2 rounded-full bg-volt-400/10 blur-3xl"></div>
  <div class="container-x relative py-20 sm:py-28">
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-[1.05] sm:text-6xl" set:html={title} />
    {lead && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">{lead}</p>}
    <slot />
  </div>
</section>
