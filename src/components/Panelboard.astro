---
/**
 * Illustration of a commercial lighting & appliance panelboard
 * (modeled on an Eaton Pow-R-Line 1a / PRL1a-style layout): gray steel
 * enclosure, main breaker at top, two vertical columns of branch
 * breakers, deadfront, hinged door with a typed circuit directory.
 * Original artwork; it contains no manufacturer logos or product photos.
 *
 * mode="deadfront": door open + deadfront in place (what a customer sees)
 * mode="interior":  deadfront removed, showing copper bus, neutral bars and breakers
 */
interface Props { mode?: 'deadfront' | 'interior'; door?: boolean; uid?: string; class?: string; title?: string; }
const {
  mode = 'deadfront',
  door = true,
  uid = 'pb',
  class: cls = '',
  title = 'Illustration of a commercial panelboard with main breaker, two columns of branch breakers and a typed circuit directory',
} = Astro.props;

type Slot = { p: number; a?: number; label?: string; space?: boolean };
const left: Slot[] = [
  { p: 3, a: 40, label: 'RTU-1' },
  { p: 1, a: 20, label: 'LTG OPEN OFC' }, { p: 1, a: 20, label: 'LTG CONF/BRK' }, { p: 1, a: 20, label: 'EXIT/EMERG' },
  { p: 1, a: 20, label: 'REC OPEN OFC' }, { p: 1, a: 20, label: 'REC OPEN OFC' }, { p: 1, a: 20, label: 'REC CONF RM' },
  { p: 2, a: 30, label: 'WATER HTR' },
  { p: 1, a: 20, label: 'REC BREAK RM' }, { p: 1, a: 20, label: 'MICROWAVE' }, { p: 1, a: 20, label: 'REFRIG' },
  { p: 1, a: 20, label: 'REC COPY/IT' }, { p: 1, a: 20, label: 'IT RACK' }, { p: 1, a: 20, label: 'SIGN' },
  { p: 2, a: 20, label: 'EF-1' },
  { p: 1, space: true }, { p: 1, space: true },
];
const right: Slot[] = [
  { p: 2, a: 40, label: 'EV CHARGER 1' },
  { p: 1, a: 20, label: 'LTG EXTERIOR' }, { p: 1, a: 20, label: 'LTG PARKING' }, { p: 1, a: 20, label: 'LTG STOREFRT' },
  { p: 1, a: 20, label: 'REC WKSTN A' }, { p: 1, a: 20, label: 'REC WKSTN B' }, { p: 1, a: 20, label: 'REC WKSTN C' },
  { p: 1, a: 20, label: 'REC RECEPTION' }, { p: 1, a: 20, label: 'DOOR ACCESS' },
  { p: 3, a: 60, label: 'RTU-2' },
  { p: 1, a: 20, label: 'REC STORAGE' }, { p: 1, a: 20, label: 'GFCI EXT' }, { p: 1, a: 20, label: 'ROOF REC' },
  { p: 1, a: 20, label: 'LTG CONTROL' }, { p: 1, a: 20, label: 'REC JANITOR' },
  { p: 1, space: true }, { p: 1, space: true }, { p: 1, space: true },
];

const ROWS = 21, Y0 = 212, PITCH = 25;
function layout(col: Slot[], side: 'L' | 'R') {
  let row = 0; const out: any[] = [];
  for (const s of col) { out.push({ ...s, row, side }); row += s.p; }
  return out;
}
const L = layout(left, 'L'), R = layout(right, 'R');

// directory rows: circuit numbers & labels
const dirRows = Array.from({ length: ROWS }, (_, r) => {
  const find = (arr: any[]) => arr.find((s) => r >= s.row && r < s.row + s.p);
  const l = find(L), rr = find(R);
  const lab = (s: any) => (s.space ? 'SPACE' : r === s.row ? s.label + (s.p > 1 ? ` ${s.p}P` : '') : '  "');
  return { odd: 2 * r + 1, even: 2 * r + 2, l: lab(l), r: lab(rr) };
});

const interior = mode === 'interior';
// geometry
const vbX = door ? 0 : 212;
const vbW = door ? 560 : 348;
const colL = interior ? { x: 278, w: 92 } : { x: 290, w: 88 };
const colR = interior ? { x: 410, w: 86 } : { x: 394, w: 88 };
const id = (n: string) => `${uid}-${n}`;
---
<svg viewBox={`${vbX} 0 ${vbW} 820`} class={cls} role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <title>{title}</title>
  <defs>
    <linearGradient id={id('steel')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#b3b9bf"/><stop offset=".5" stop-color="#9ba2a9"/><stop offset="1" stop-color="#868d94"/>
    </linearGradient>
    <linearGradient id={id('dead')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#a7aeb5"/><stop offset=".5" stop-color="#bcc2c8"/><stop offset="1" stop-color="#a3aab1"/>
    </linearGradient>
    <linearGradient id={id('door')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7f868d"/><stop offset="1" stop-color="#959ca3"/>
    </linearGradient>
    <linearGradient id={id('brk')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a2d32"/><stop offset="1" stop-color="#16181b"/>
    </linearGradient>
    <linearGradient id={id('handle')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4a4f57"/><stop offset="1" stop-color="#2a2e34"/>
    </linearGradient>
    <linearGradient id={id('cu')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#9c5a2b"/><stop offset=".45" stop-color="#e3a26a"/><stop offset="1" stop-color="#a8622f"/>
    </linearGradient>
    <linearGradient id={id('tin')} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#8e959c"/><stop offset=".5" stop-color="#dfe3e7"/><stop offset="1" stop-color="#8e959c"/>
    </linearGradient>
    <filter id={id('sh')} x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#000" flood-opacity=".55"/>
    </filter>
  </defs>

  {door && (
    <g filter={`url(#${id('sh')})`}>
      {/* Door (swung fully open, inside face) */}
      <rect x="14" y="26" width="196" height="768" rx="6" fill={`url(#${id('door')})`} stroke="#5d646b" stroke-width="2"/>
      <rect x="24" y="36" width="176" height="748" rx="4" fill="none" stroke="#6c737a" stroke-width="1.5" opacity=".8"/>
      {/* latch */}
      <rect x="20" y="386" width="10" height="48" rx="3" fill="#2b2f35"/>
      <circle cx="25" cy="410" r="3" fill="#8a9097"/>
      {/* panel nameplate */}
      <rect x="66" y="46" width="92" height="16" rx="2" fill="#1b1d21"/>
      <text x="112" y="57.5" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="8.5" font-weight="700" fill="#f2f2f2" letter-spacing="1.5">PANEL LP-1</text>
      {/* directory holder + card */}
      <rect x="32" y="72" width="160" height="540" rx="3" fill="#5f666d"/>
      <rect x="36" y="76" width="152" height="532" fill="#f4f1e8"/>
      <text x="112" y="92" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="8.5" font-weight="700" fill="#1b1d21" letter-spacing=".8">CIRCUIT DIRECTORY</text>
      <text x="112" y="103" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="5.6" fill="#3d4148">LP-1 · 208Y/120V · 3PH 4W · 225A MCB</text>
      <line x1="40" y1="108" x2="184" y2="108" stroke="#1b1d21" stroke-width=".8"/>
      <line x1="112" y1="108" x2="112" y2="600" stroke="#c9c4b5" stroke-width=".6"/>
      {dirRows.map((d, i) => (
        <g font-family="ui-monospace,Menlo,monospace" font-size="5.7" fill="#22252a">
          <text x="40" y={120 + i * 23}><tspan font-weight="700">{String(d.odd).padStart(2, '0')}</tspan> {d.l}</text>
          <text x="115" y={120 + i * 23}><tspan font-weight="700">{String(d.even).padStart(2, '0')}</tspan> {d.r}</text>
          <line x1="40" y1={125 + i * 23} x2="184" y2={125 + i * 23} stroke="#d8d3c4" stroke-width=".5"/>
        </g>
      ))}
      {/* clear sleeve sheen */}
      <path d="M36 76 L120 76 L60 608 L36 608 Z" fill="#fff" opacity=".10"/>
      {/* warning label */}
      <rect x="44" y="632" width="136" height="64" rx="2" fill="#f7f7f5"/>
      <rect x="44" y="632" width="136" height="16" rx="2" fill="#f07f13"/>
      <text x="112" y="643.5" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="9" font-weight="700" fill="#111">⚠ WARNING</text>
      {[656, 664, 672, 680, 688].map((y, i) => <rect x="52" y={y} width={i === 4 ? 70 : 120} height="3" rx="1.5" fill="#9aa0a6"/>)}
      {/* hinge */}
      <rect x="208" y="60" width="20" height="700" rx="2" fill="#7a8188" stroke="#5d646b"/>
      {Array.from({ length: 14 }, (_, i) => <line x1="208" x2="228" y1={60 + i * 50} y2={60 + i * 50} stroke="#5d646b" stroke-width="1"/>)}
    </g>
  )}

  <g filter={`url(#${id('sh')})`}>
    {/* Trim / enclosure */}
    <rect x="226" y="14" width="320" height="792" rx="8" fill={`url(#${id('steel')})`} stroke="#5d646b" stroke-width="2"/>
    {[[240, 30], [532, 30], [240, 410], [532, 410], [240, 790], [532, 790]].map(([cx, cy]) => (
      <g><circle cx={cx} cy={cy} r="4.5" fill="#d3d7db" stroke="#5d646b"/><line x1={cx - 2.6} y1={cy} x2={cx + 2.6} y2={cy} stroke="#5d646b" stroke-width="1.2"/></g>
    ))}
    {/* opening */}
    <rect x="250" y="42" width="272" height="738" rx="4" fill={interior ? '#5b6168' : `url(#${id('dead')})`} stroke="#6b727a" stroke-width="2"/>
  </g>

  {interior && (
    <g>
      {/* back pan texture */}
      <rect x="254" y="46" width="264" height="730" fill="#656b72"/>
      {/* neutral bars */}
      {[258, 504].map((x) => (
        <g>
          <rect x={x} y="200" width="10" height="540" rx="2" fill={`url(#${id('tin')})`}/>
          {Array.from({ length: 27 }, (_, i) => <circle cx={x + 5} cy={210 + i * 20} r="2.2" fill="#5d646b"/>)}
        </g>
      ))}
      {/* ground bar */}
      <rect x="300" y="752" width="172" height="10" rx="2" fill={`url(#${id('tin')})`}/>
      {Array.from({ length: 12 }, (_, i) => <circle cx={308 + i * 14} cy="757" r="2.2" fill="#3f8f4f"/>)}
      {/* copper bus: phases A, B, C */}
      {[374, 386, 398].map((x) => <rect x={x} y="186" width="9" height="552" rx="1.5" fill={`url(#${id('cu')})`} stroke="#6b3a17" stroke-width=".6"/>)}
      {/* bus straps */}
      {Array.from({ length: ROWS }, (_, r) => {
        const used = (arr: any[]) => arr.some((sl) => !sl.space && r >= sl.row && r < sl.row + sl.p);
        const x1 = used(L) ? 358 : 371, x2 = used(R) ? 420 : 408;
        return <rect x={x1} y={Y0 + r * PITCH + 8} width={x2 - x1} height="7" rx="1.5" fill={`url(#${id('cu')})`} opacity=".95" stroke="#6b3a17" stroke-width=".5"/>;
      })}
    </g>
  )}

  {/* Main breaker */}
  <g>
    <rect x="322" y="62" width="128" height="116" rx="6" fill={`url(#${id('brk')})`} stroke="#0c0d0f" stroke-width="1.5"/>
    {[[330, 70], [442, 70], [330, 170], [442, 170]].map(([cx, cy]) => <circle cx={cx} cy={cy} r="2.6" fill="#7b8189"/>)}
    <rect x="370" y="88" width="32" height="66" rx="3" fill="#0d0e10"/>
    <rect x="374" y="92" width="24" height="28" rx="3" fill={`url(#${id('handle')})`}/>
    <text x="386" y="132" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="6.5" fill="#9aa0a6">ON</text>
    <text x="386" y="148" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="6.5" fill="#9aa0a6">OFF</text>
    <rect x="334" y="96" width="28" height="12" rx="1.5" fill="#e9eaec"/>
    <text x="348" y="104.8" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="6.6" font-weight="700" fill="#16181b">225</text>
    <text x="348" y="122" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="6" fill="#c9ccd0">MAIN</text>
    <rect x="410" y="96" width="28" height="40" rx="2" fill="#24272c"/>
    {[102, 110, 118, 126].map((y) => <rect x="414" y={y} width="20" height="2.2" rx="1" fill="#555b63"/>)}
    {interior && [338, 386, 434].map((x) => <rect x={x - 9} y="44" width="18" height="16" rx="2" fill="#c7a15a" stroke="#6b5427"/>)}
  </g>

  {/* Deadfront seam lines & circuit numbers */}
  {!interior && (
    <g>
      <line x1="252" y1="192" x2="520" y2="192" stroke="#8c939a" stroke-width="1"/>
      <rect x="284" y={Y0 - 6} width="204" height={ROWS * PITCH + 8} rx="3" fill="#868d94" opacity=".55"/>
      {Array.from({ length: ROWS }, (_, r) => (
        <g font-family="Arial,Helvetica,sans-serif" font-size="8" font-weight="700" fill="#2d3137">
          <text x="276" y={Y0 + r * PITCH + 15} text-anchor="end">{2 * r + 1}</text>
          <text x="496" y={Y0 + r * PITCH + 15}>{2 * r + 2}</text>
        </g>
      ))}
      {[[262, 60], [510, 60], [262, 770], [510, 770]].map(([cx, cy]) => <circle cx={cx} cy={cy} r="3" fill="#d3d7db" stroke="#6b727a"/>)}
    </g>
  )}

  {/* Branch breakers */}
  {[...L, ...R].map((s) => {
    const c = s.side === 'L' ? colL : colR;
    const y = Y0 + s.row * PITCH;
    const h = s.p * PITCH - 3;
    if (s.space) {
      return interior
        ? <rect x={c.x + 4} y={y + 2} width={c.w - 8} height={h - 2} rx="2" fill="none" stroke="#4d535a" stroke-dasharray="3 3"/>
        : <rect x={c.x} y={y} width={c.w} height={h} rx="2" fill="#b0b7be" stroke="#8a9198"/>;
    }
    // handle sits toward the center bus on each side
    const hx = s.side === 'L' ? c.x + c.w - 40 : c.x + 12;
    const ax = s.side === 'L' ? c.x + 14 : c.x + c.w - 14;
    const boltX = s.side === 'L' ? c.x + c.w - 6 : c.x + 6;
    return (
      <g>
        <rect x={c.x} y={y} width={c.w} height={h} rx="2.5" fill={`url(#${id('brk')})`} stroke="#0b0c0e" stroke-width="1"/>
        <line x1={c.x + 3} y1={y + 1.5} x2={c.x + c.w - 3} y2={y + 1.5} stroke="#fff" stroke-opacity=".12"/>
        {Array.from({ length: s.p }, (_, k) => (
          <g>
            <rect x={hx} y={y + k * PITCH + 4} width="28" height={PITCH - 11} rx="2" fill={`url(#${id('handle')})`} stroke="#0b0c0e" stroke-width=".6"/>
            <rect x={hx + 3} y={y + k * PITCH + 5.5} width="22" height="1.6" rx=".8" fill="#fff" opacity=".18"/>
            {interior && <circle cx={boltX} cy={y + k * PITCH + 11.5} r="3.4" fill="#c9ced3" stroke="#3c4148"/>}
            {k > 0 && <line x1={c.x + 4} x2={c.x + c.w - 4} y1={y + k * PITCH - 1.5} y2={y + k * PITCH - 1.5} stroke="#0b0c0e" stroke-width=".8"/>}
          </g>
        ))}
        {s.p > 1 && <rect x={hx + 12} y={y + 6} width="4" height={(s.p - 1) * PITCH + 6} rx="1" fill="#55606b"/>}
        <text x={ax} y={y + 14.5} text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-size="7.5" font-weight="700" fill="#e9ecef">{s.a}</text>
      </g>
    );
  })}
</svg>
