---
import ProjectArt from './ProjectArt.astro';
import Icon from './Icon.astro';
interface Props { p: { category: string; title: string; location: string; year: string; scope: string[]; art: number }; detailed?: boolean; }
const { p, detailed = false } = Astro.props;
---
<article class="card card-hover group overflow-hidden">
  <div class="relative aspect-[5/3] overflow-hidden border-b border-white/[0.07]">
    <ProjectArt variant={p.art} class="h-full w-full transition duration-500 group-hover:scale-[1.04]" />
    <span class="placeholder-tag absolute left-4 top-4 bg-night-900/80 backdrop-blur"><Icon name="ImagePlus" class="h-3 w-3" />Placeholder: add job photo</span>
  </div>
  <div class="p-6">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-volt-400">{p.category}</p>
    <h3 class="mt-2 text-lg font-semibold"><span class="placeholder-text">{p.title}</span></h3>
    <p class="mt-3 flex items-center gap-2 text-sm text-slate-400"><Icon name="MapPin" class="h-3.5 w-3.5" /><span class="placeholder-text text-xs">{p.location}</span><span class="text-slate-500">·</span><span class="placeholder-text text-xs">{p.year}</span></p>
    {detailed && (
      <ul class="mt-5 space-y-2 border-t border-white/[0.07] pt-5 text-sm">
        {p.scope.map((s) => <li class="flex gap-2.5"><Icon name="Check" class="mt-0.5 h-4 w-4 text-volt-400" /><span class="placeholder-text text-xs leading-5">{s}</span></li>)}
      </ul>
    )}
  </div>
</article>
