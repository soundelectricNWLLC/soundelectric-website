---
import * as icons from 'lucide-static';
interface Props { name: string; class?: string; }
const { name, class: cls = 'h-5 w-5' } = Astro.props;
// Site-specific glyphs drawn in the same 24px, stroke-2 style as Lucide (which has no tooth icon).
const custom: Record<string, string> = {
  Tooth: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.5 3C5 3 3 5 3 7.7c0 2 .7 3.4 1.3 4.7.6 1.3 1 2.7 1.2 4.6l.4 2.6c.2 1.2.9 1.9 1.8 1.9.9 0 1.6-.7 1.8-1.7l.7-3.3c.2-1 .9-1.7 1.8-1.7s1.6.7 1.8 1.7l.7 3.3c.2 1 .9 1.7 1.8 1.7.9 0 1.6-.7 1.8-1.9l.4-2.6c.2-1.9.6-3.3 1.2-4.6.6-1.3 1.3-2.7 1.3-4.7C21 5 19 3 16.5 3c-1.9 0-2.8 1-4.5 1S9.4 3 7.5 3Z"/><path d="M9 7.2c1 .5 2 .8 3 .8"/></svg>',
};
const svg = custom[name] ?? (icons as Record<string, string>)[name] ?? (icons as Record<string, string>).Zap;
---
<span class:list={['icon-svg inline-block shrink-0', cls]} aria-hidden="true" set:html={svg} />
