---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE, SERVICES } from '../data/site';
import { WEB3FORMS_ENDPOINT, WEB3FORMS_ACCESS_KEY, QUOTE_SUBJECT, QUOTE_FROM_NAME } from '../data/forms';
const field = 'mt-2 block w-full rounded-xl border border-white/10 bg-night-950/60 px-4 py-3 text-white placeholder:text-slate-400 transition focus:border-volt-400/70 focus:outline-none focus:ring-4 focus:ring-volt-400/15';
const label = 'text-sm font-medium text-slate-200';
---
<Base
  title="Request a Quote | Commercial Electrician Seattle | Sound Electric NW"
  description="Request a quote from Sound Electric NW LLC, a licensed commercial electrical contractor serving Seattle, King County and the Eastside. Call (425) 971-7987.">
  <section class="relative overflow-hidden">
    <div class="bg-grid mask-radial absolute inset-0"></div>
    <div class="absolute -top-32 left-1/3 h-96 w-[40rem] rounded-full bg-volt-400/10 blur-3xl"></div>
    <div class="container-x relative grid gap-12 py-16 sm:py-24 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <span class="eyebrow">Contact</span>
        <h1 class="mt-5 text-4xl font-semibold leading-[1.05] sm:text-6xl">Request a <span class="text-gradient">quote</span>.</h1>
        <p class="mt-6 text-lg leading-relaxed text-slate-300">Tell us about your commercial project. Drawings, photos of existing equipment and your target schedule all help us scope it accurately.</p>

        <div class="mt-10 space-y-3">
          <a href={SITE.phoneHref} class="card card-hover group flex items-center gap-4 p-5">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-volt-400 text-night-950"><Icon name="Phone" class="h-5 w-5" /></span>
            <span><span class="block font-mono text-[11px] uppercase tracking-[0.18em] text-slate-400">Call</span><span class="font-display text-xl font-semibold text-white">{SITE.phone}</span></span>
            <Icon name="ArrowUpRight" class="ml-auto h-5 w-5 text-slate-400 transition group-hover:text-volt-400" />
          </a>
          <a href={`mailto:${SITE.email}`} class="card card-hover group flex items-center gap-4 p-5">
            <span class="grid h-12 w-12 place-items-center rounded-xl border border-volt-400/30 bg-volt-400/10 text-volt-400"><Icon name="Mail" class="h-5 w-5" /></span>
            <span class="min-w-0"><span class="block font-mono text-[11px] uppercase tracking-[0.18em] text-slate-400">Email</span><span class="block truncate font-display text-lg font-semibold text-white">{SITE.email}</span></span>
            <Icon name="ArrowUpRight" class="ml-auto h-5 w-5 shrink-0 text-slate-400 transition group-hover:text-volt-400" />
          </a>
          <div class="card flex items-center gap-4 p-5">
            <span class="grid h-12 w-12 place-items-center rounded-xl border border-white/10 bg-night-800 text-volt-400"><Icon name="MapPin" class="h-5 w-5" /></span>
            <span><span class="block font-mono text-[11px] uppercase tracking-[0.18em] text-slate-400">Service area</span><span class="font-semibold text-white">Seattle, King County &amp; the Eastside</span></span>
          </div>
        </div>
        <a href={SITE.licenseVerifyUrl} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 text-sm text-slate-400 hover:text-white"><Icon name="ShieldCheck" class="h-4 w-4 text-volt-400" />Licensed, Bonded &amp; Insured · WA Lic. {SITE.license} · Verify<Icon name="ArrowUpRight" class="h-3.5 w-3.5" /></a>
      </div>

      <div class="lg:col-span-7">
        <!-- Quote form: sent from the browser to Web3Forms (fetch + JSON, no page reload). Without JS it falls back to a normal POST. -->
        <form id="quote-form" class="card p-6 sm:p-10" action={WEB3FORMS_ENDPOINT} method="post" data-endpoint={WEB3FORMS_ENDPOINT} data-state="idle">
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" value={QUOTE_SUBJECT} />
          <input type="hidden" name="from_name" value={QUOTE_FROM_NAME} />
          <!-- Honeypot (Web3Forms "botcheck"): hidden from people; submissions with it ticked are rejected as spam. -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <h2 class="text-2xl font-semibold">Project details</h2>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            <label class="block"><span class={label}>Name <span class="text-volt-400">*</span></span><input class={field} name="name" autocomplete="name" required placeholder="Full name" /></label>
            <label class="block"><span class={label}>Company</span><input class={field} name="company" autocomplete="organization" placeholder="Company or property" /></label>
            <label class="block"><span class={label}>Email <span class="text-volt-400">*</span></span><input class={field} type="email" name="email" autocomplete="email" required placeholder="you@company.com" /></label>
            <label class="block"><span class={label}>Phone</span><input class={field} type="tel" name="phone" autocomplete="tel" placeholder="(206) 555-0123" /></label>
            <label class="block sm:col-span-2"><span class={label}>Project type <span class="text-volt-400">*</span></span>
              <span class="relative mt-2 block"><select class={field + ' !mt-0 appearance-none pr-12'} name="project_type" id="project_type" required>
                <option value="" disabled selected>Select a project type</option>
                {SERVICES.map((s) => <option value={s.id}>{s.title}</option>)}
                <option value="other">Other commercial work</option>
              </select><Icon name="ChevronDown" class="pointer-events-none absolute right-4 top-1/2 h-[18px] w-[18px] -translate-y-1/2 text-volt-400" /></span>
            </label>
            <label class="block sm:col-span-2"><span class={label}>Message <span class="text-volt-400">*</span></span><textarea class={field + ' min-h-[160px] resize-y'} name="message" required placeholder="Site address or area, scope, schedule, and whether drawings are available."></textarea></label>
          </div>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs text-slate-400">Prefer to talk? Call <a href={SITE.phoneHref} class="text-slate-300 hover:text-white">{SITE.phone}</a>.</p>
            <button type="submit" id="quote-submit" class="btn btn-primary !px-8 !py-4 text-base disabled:pointer-events-none disabled:opacity-70"><span data-label>Send request</span> <Icon name="Send" class="h-4 w-4" /></button>
          </div>
          <p id="form-status" class="mt-5 hidden rounded-xl border p-4 text-sm leading-relaxed" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>
</Base>
<script>
  const PHONE = '(425) 971-7987';
  const PHONE_HREF = 'tel:+14259717987';
  const EMAIL = 'jeremiah@soundelectric.com';
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const button = document.getElementById('quote-submit') as HTMLButtonElement | null;
  const buttonLabel = button?.querySelector('[data-label]');
  const sel = document.getElementById('project_type') as HTMLSelectElement | null;

  // Prefill the project type from /contact/?type=<service-id> (used by the Services page buttons).
  const type = new URLSearchParams(location.search).get('type');
  if (type && sel && [...sel.options].some((o) => o.value === type)) sel.value = type;

  const STYLES = {
    sending: ['border-white/10', 'bg-white/[0.03]', 'text-slate-300'],
    success: ['border-emerald-400/40', 'bg-emerald-400/[0.08]', 'text-emerald-200'],
    error: ['border-red-400/50', 'bg-red-500/[0.08]', 'text-red-200'],
  } as const;
  const ALL_STYLES: string[] = Object.values(STYLES).flat();

  function link(href: string, text: string) {
    const a = document.createElement('a');
    a.href = href;
    a.textContent = text;
    a.className = 'font-semibold text-white underline underline-offset-2';
    return a;
  }

  function showStatus(state: keyof typeof STYLES, parts: (string | Node)[]) {
    if (!status) return;
    status.classList.remove('hidden', ...ALL_STYLES);
    status.classList.add(...STYLES[state]);
    status.dataset.state = state;
    status.setAttribute('role', state === 'error' ? 'alert' : 'status');
    status.replaceChildren(...parts);
  }

  function setBusy(busy: boolean) {
    if (!button || !form) return;
    button.disabled = busy;
    form.setAttribute('aria-busy', String(busy));
    if (buttonLabel) buttonLabel.textContent = busy ? 'Sending…' : 'Send request';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (form.dataset.state === 'sending') return;
    if (!form.checkValidity()) { form.reportValidity(); return; }

    const data: Record<string, string> = {};
    new FormData(form).forEach((v, k) => { data[k] = typeof v === 'string' ? v.trim() : ''; });
    // Send the readable project type (e.g. "Panel upgrades") rather than the internal id.
    if (sel && sel.selectedIndex > 0) data.project_type = sel.options[sel.selectedIndex].text.trim();
    // Replies to the notification email go straight to the visitor.
    if (data.email) data.replyto = data.email;

    form.dataset.state = 'sending';
    setBusy(true);
    showStatus('sending', ['Sending your request…']);

    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 20000);
    try {
      const res = await fetch(form.dataset.endpoint || form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
        signal: ctrl.signal,
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error(json?.message || `HTTP ${res.status}`);
      form.dataset.state = 'success';
      form.reset();
      showStatus('success', [
        'Thanks! Your quote request was sent. We will get back to you soon. For anything urgent, call ',
        link(PHONE_HREF, PHONE), '.',
      ]);
    } catch (err) {
      console.error('Quote form submission failed:', err);
      form.dataset.state = 'error';
      showStatus('error', [
        'Sorry, your request could not be sent. Please call ',
        link(PHONE_HREF, PHONE), ' or email ', link(`mailto:${EMAIL}`, EMAIL), '.',
      ]);
    } finally {
      clearTimeout(timer);
      setBusy(false);
    }
  });
</script>
