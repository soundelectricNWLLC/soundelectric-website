---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { SITE, SHOW_OWNER_BIO, SHOW_JOB_SITE_PHOTO } from '../data/site';
const values = [
  { icon: 'HardHat', title: 'Safety first', text: 'Safe work practices on every job, for our crew, your staff and your customers.' },
  { icon: 'FileCheck2', title: 'Code-compliant work', text: 'Permitted, inspected installations that meet the electrical code.' },
  { icon: 'MessagesSquare', title: 'Clear communication', text: 'Straight answers on scope, schedule and cost, with no surprises at closeout.' },
  { icon: 'Sparkles', title: 'Clean installs', text: 'Neat terminations, labeled circuits and a tidy site at the end of each day.' },
];
---
<Base
  title="About Sound Electric | Licensed Commercial Electrical Contractor, Seattle"
  description="Sound Electric is a licensed, bonded and insured Washington commercial electrical contractor serving the Greater Seattle Area.">
  <PageHero eyebrow="About" title='A commercial electrical contractor built for <span class="text-gradient">Seattle</span> business.'
    lead="Sound Electric is a licensed, bonded and insured Washington electrical contractor focused on commercial work across the Greater Seattle Area." />

  <section class="container-x mt-16 sm:mt-24">
    <div class:list={['grid gap-10', SHOW_JOB_SITE_PHOTO && 'lg:grid-cols-12']}>
      <div class:list={[SHOW_JOB_SITE_PHOTO ? 'lg:col-span-7' : 'max-w-3xl']}>
        <span class="eyebrow">Who we are</span>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Commercial-focused, start to finish.</h2>
        <div class="mt-6 space-y-5 text-lg leading-relaxed text-slate-300">
          <p>Sound Electric works with business owners, property managers and general contractors on tenant improvements, build-outs, lighting upgrades, service and panel work, EV charging, and the maintenance that keeps commercial spaces running. Dental and veterinary clinics are our specialty.</p>
          <p>We handle the electrical scope from the first site walk through permits, installation and final inspection.</p>
          {SHOW_OWNER_BIO && (
            <p class="rounded-xl border border-dashed border-arc-400/40 bg-arc-400/[0.05] p-5 font-mono text-base text-arc-200">[Owner bio goes here: Jeremiah's background, trade experience and what drives the company. Use only verifiable facts; don't list years or certifications unless they are accurate.]</p>
          )}
        </div>
      </div>
      {SHOW_JOB_SITE_PHOTO && (
        <div class="lg:col-span-5">
          <div class="grid aspect-[4/5] place-items-center rounded-2xl border border-dashed border-arc-400/40 bg-[radial-gradient(circle_at_30%_20%,rgba(62,224,245,.12),transparent_60%)] p-8 text-center">
            <div>
              <Icon name="Camera" class="mx-auto h-10 w-10 text-arc-300" />
              <p class="mt-4 placeholder-tag">Placeholder</p>
              <p class="mt-3 font-mono text-sm text-arc-200">[Photo of Jeremiah / crew on a commercial job site]</p>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="container-x mt-24">
    <span class="eyebrow">Credentials</span>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      <a href={SITE.licenseVerifyUrl} target="_blank" rel="noopener" class="card card-hover group p-7">
        <Icon name="BadgeCheck" class="h-8 w-8 text-volt-400" />
        <h3 class="mt-5 text-xl font-semibold">WA Electrical Contractor</h3>
        <p class="mt-2 font-mono text-slate-300">License {SITE.license}</p>
        <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-volt-400">Verify on L&amp;I <Icon name="ArrowUpRight" class="h-4 w-4" /></p>
      </a>
      <div class="card p-7">
        <Icon name="ShieldCheck" class="h-8 w-8 text-volt-400" />
        <h3 class="mt-5 text-xl font-semibold">Licensed, Bonded &amp; Insured</h3>
        <p class="mt-2 text-slate-400">Ask us for proof of coverage for your project file.</p>
      </div>
      <div class="card p-7">
        <Icon name="MapPin" class="h-8 w-8 text-volt-400" />
        <h3 class="mt-5 text-xl font-semibold">Greater Seattle Area</h3>
        <p class="mt-2 text-slate-400">Seattle and the Eastside, north to Bellingham, south to Tacoma, and west to Poulsbo and Port Orchard.</p>
      </div>
    </div>
  </section>

  <section class="container-x mt-24">
    <span class="eyebrow">How we operate</span>
    <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">What you can expect.</h2>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {values.map((v) => (
        <div class="card p-7">
          <span class="grid h-11 w-11 place-items-center rounded-xl border border-volt-400/25 bg-volt-400/[0.08] text-volt-400"><Icon name={v.icon} class="h-5 w-5" /></span>
          <h3 class="mt-5 text-lg font-semibold">{v.title}</h3>
          <p class="mt-2 leading-relaxed text-slate-400">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <FinalCTA />
</Base>
