---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { Picture } from 'astro:assets';
import panelEaton from '../assets/panel-eaton-pow-r-line.jpg';
import panelSiemens from '../assets/panel-siemens-42-circuit.jpg';
import { SITE, SERVICES, SERVICE_AREAS, INDUSTRIES } from '../data/site';
const areaServed = [{ '@type': 'AdministrativeArea', name: 'Greater Seattle Area' }, ...SERVICE_AREAS.map((c) => ({ '@type': 'City', name: `${c}, WA` }))];
const serviceSchema = [
  ...SERVICES.map((s) => ({
    '@context': 'https://schema.org', '@type': 'Service', name: s.title, description: s.short,
    serviceType: s.title, provider: { '@id': `${SITE.url}/#business` },
    areaServed,
    url: `${SITE.url}/services/#${s.id}`,
  })),
  // One entry per industry (dental office electrician, veterinary clinic electrician, restaurant electrician, ...).
  ...INDUSTRIES.map((ind) => ({
    '@context': 'https://schema.org', '@type': 'Service', name: ind.label.replace(/^./, (c) => c.toUpperCase()), description: ind.text,
    serviceType: ind.schemaName, provider: { '@id': `${SITE.url}/#business` },
    audience: { '@type': 'BusinessAudience', audienceType: ind.title },
    areaServed,
    url: `${SITE.url}/services/#industries`,
  })),
];
---
<Base
  title="Commercial Electrical Services | Commercial Electrician Seattle | Sound Electric"
  description="Commercial electrician for the Greater Seattle Area: tenant improvements, build-outs, LED retrofits, panel upgrades, EV charging and service work. Dental office, veterinary clinic and restaurant electrician."
  jsonLd={serviceSchema}>
  <PageHero eyebrow="Services" title='Commercial electrical services for the <span class="text-gradient">Greater Seattle Area</span>.'
    lead="One licensed, bonded and insured contractor for the electrical scope on commercial projects: from a single panel to a full build-out.">
    <nav class="mt-10 flex flex-wrap gap-2" aria-label="Jump to service">
      {SERVICES.map((s) => <a href={`#${s.id}`} class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-sm text-slate-200 transition hover:border-volt-400/50 hover:text-white"><Icon name={s.icon} class="h-4 w-4 text-volt-400" />{s.title}</a>)}
    </nav>
  </PageHero>

  <div class="container-x mt-16 space-y-6 sm:mt-24">
    {SERVICES.map((s, i) => {
      const panel = s.id === 'service-panel-upgrades';
      const scope = (
        <div class:list={['rounded-2xl border border-white/[0.07] bg-night-950/50 p-6 sm:p-7', panel && 'mt-8']}>
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-volt-400">Typical scope</p>
          <ul class:list={['mt-5 gap-3.5', panel ? 'grid sm:grid-cols-2' : 'space-y-3.5']}>
            {s.includes.map((t) => <li class="flex gap-3 text-slate-200"><Icon name="Check" class="mt-0.5 h-5 w-5 text-volt-400" />{t}</li>)}
          </ul>
        </div>
      );
      return (
      <section id={s.id} class="card scroll-mt-28 overflow-hidden">
        <div class="grid gap-10 p-7 sm:p-10 lg:grid-cols-12 lg:gap-14 lg:p-14">
          <div class:list={[panel ? 'lg:col-span-6' : 'lg:col-span-7']}>
            <div class="flex items-center gap-4">
              <span class="grid h-14 w-14 place-items-center rounded-2xl border border-volt-400/30 bg-volt-400/10 text-volt-400"><Icon name={s.icon} class="h-7 w-7" /></span>
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400">Service {String(i + 1).padStart(2, '0')}</span>
            </div>
            <h2 class="mt-7 text-3xl font-semibold sm:text-4xl">{s.title}</h2>
            <p class="mt-5 text-lg leading-relaxed text-slate-300">{s.body}</p>
            <p class="mt-6 text-sm text-slate-400"><span class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-400">Good fit for</span><br/><span class="text-slate-200">{s.goodFor}</span></p>
            {panel && scope}
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={`/contact/?type=${s.id}`} class="btn btn-primary">Request a Quote <Icon name="ArrowRight" class="h-4 w-4" /></a>
              <a href={SITE.phoneHref} class="btn btn-ghost"><Icon name="Phone" class="h-4 w-4 text-volt-400" />{SITE.phone}</a>
            </div>
          </div>
          <div class:list={[panel ? 'lg:col-span-6' : 'lg:col-span-5']}>
            {panel ? (
              <!-- Panel photos (Jeremiah's own). Lead: Eaton Pow-R-Line. The SVG in src/components/Panelboard.astro is no longer shown here. -->
              <div class="relative rounded-2xl border border-white/[0.07] bg-night-950/50 p-3 sm:p-5">
                <div class="pointer-events-none absolute inset-12 rounded-full bg-volt-400/10 blur-3xl"></div>
                <div class="relative grid gap-3 sm:grid-cols-5 sm:gap-4">
                  <figure class="sm:col-span-3">
                    <div class="relative aspect-[3/4] overflow-hidden rounded-xl bg-night-800">
                      <Picture
                        src={panelEaton}
                        formats={['webp']}
                        fallbackFormat="jpg"
                        widths={[320, 480, 640, 800, 1100]}
                        sizes="(min-width: 1024px) 290px, (min-width: 640px) 50vw, calc(100vw - 7.5rem)"
                        loading="lazy"
                        alt="Eaton Pow-R-Line commercial panelboard installed by Sound Electric, door open with the deadfront on and 42 numbered circuit spaces"
                        class="h-full w-full object-cover"
                      />
                      <div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-white/10"></div>
                    </div>
                    <figcaption class="mt-3 text-center font-mono text-[10px] uppercase tracking-[0.16em] text-slate-400">Eaton Pow-R-Line · deadfront</figcaption>
                  </figure>
                  <figure class="flex flex-col sm:col-span-2">
                    <div class="relative aspect-[4/3] overflow-hidden rounded-xl bg-night-800 sm:aspect-auto sm:min-h-0 sm:flex-1">
                      <Picture
                        src={panelSiemens}
                        formats={['webp']}
                        fallbackFormat="jpg"
                        widths={[320, 480, 640, 768]}
                        sizes="(min-width: 1024px) 290px, (min-width: 640px) 50vw, calc(100vw - 7.5rem)"
                        loading="lazy"
                        alt="Siemens 42-circuit commercial panelboard with numbered circuit positions and a breaker labeled Break Room"
                        class="absolute inset-0 h-full w-full object-cover object-[50%_26%] sm:object-center"
                      />
                      <div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-white/10"></div>
                    </div>
                    <figcaption class="mt-3 text-center font-mono text-[10px] uppercase tracking-[0.16em] text-slate-400">Siemens · 42-circuit</figcaption>
                  </figure>
                </div>
                <p class="relative mt-4 text-xs leading-relaxed text-slate-400">Commercial bolt-on panelboards from our panel work.</p>
              </div>
            ) : scope}
          </div>
        </div>
      </section>
      );
    })}
  </div>

  <section class="container-x mt-16 scroll-mt-28 sm:mt-24" id="industries">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <span class="eyebrow">Industries</span>
        <h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Who we work for.</h2>
        <p class="mt-4 text-slate-400">Dental and veterinary clinics are our specialty. We also wire offices and restaurants, and handle service work for existing commercial spaces.</p>
      </div>
      <a href="/#industries" class="group inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-volt-300">Industry details <Icon name="ArrowRight" class="h-4 w-4 transition group-hover:translate-x-1" /></a>
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
      {INDUSTRIES.map((ind) => (
        <li class:list={['card flex gap-4 p-5 sm:p-6', ind.specialty ? '!border-volt-400/30 lg:col-span-3' : 'lg:col-span-2']}>
          <span class:list={['grid h-11 w-11 shrink-0 place-items-center rounded-xl', ind.specialty ? 'bg-volt-400 text-night-950' : 'border border-white/10 bg-night-800 text-volt-400']}><Icon name={ind.icon} class="h-5 w-5" /></span>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
              <h3 class="text-lg font-semibold">{ind.title}</h3>
              {ind.specialty && <span class="inline-flex items-center gap-1 rounded-full bg-volt-400 px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-night-950"><Icon name="Star" class="h-2.5 w-2.5" />Specialty</span>}
            </div>
            <p class="mt-1 font-mono text-[10.5px] uppercase tracking-[0.16em] text-volt-400/90">{ind.label}</p>
            <ul class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1.5 text-sm text-slate-400">
              {ind.points.map((t) => <li class="flex items-center gap-2"><span class="h-1 w-1 shrink-0 rounded-full bg-volt-400/80" aria-hidden="true"></span>{t}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-x mt-16">
    <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-7 text-sm text-slate-400 sm:p-8">
      <p><span class="font-semibold text-white">Not sure which service fits?</span> Many commercial projects combine several of these, like a TI that needs a panel upgrade, or an LED retrofit paired with EV charging. Tell us what you are trying to accomplish and we will scope it together.</p>
    </div>
  </section>

  <FinalCTA />
</Base>
