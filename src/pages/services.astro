---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Panelboard from '../components/Panelboard.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { SITE, SERVICES, SERVICE_AREAS } from '../data/site';
const serviceSchema = SERVICES.map((s) => ({
  '@context': 'https://schema.org', '@type': 'Service', name: s.title, description: s.short,
  serviceType: s.title, provider: { '@id': `${SITE.url}/#business` },
  areaServed: [{ '@type': 'AdministrativeArea', name: 'Greater Seattle Area' }, ...SERVICE_AREAS.map((c) => ({ '@type': 'City', name: `${c}, WA` }))],
  url: `${SITE.url}/services/#${s.id}`,
}));
---
<Base
  title="Commercial Electrical Services | Commercial Electrician Seattle | Sound Electric NW"
  description="Commercial electrician serving the Greater Seattle Area: tenant improvements, office & retail build-outs, LED lighting retrofits, service & panel upgrades, EV charging and maintenance."
  jsonLd={serviceSchema}>
  <PageHero eyebrow="Services" title='Commercial electrical services for the <span class="text-gradient">Greater Seattle Area</span>.'
    lead="One licensed, bonded and insured contractor for the electrical scope on commercial projects: from a single panel to a full build-out.">
    <nav class="mt-10 flex flex-wrap gap-2" aria-label="Jump to service">
      {SERVICES.map((s) => <a href={`#${s.id}`} class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-4 py-2 text-sm text-slate-200 transition hover:border-volt-400/50 hover:text-white"><Icon name={s.icon} class="h-4 w-4 text-volt-400" />{s.title}</a>)}
    </nav>
  </PageHero>

  <div class="container-x mt-16 space-y-6 sm:mt-24">
    {SERVICES.map((s, i) => {
      const panel = s.id === 'service-panel-upgrades';
      const scope = (
        <div class:list={['rounded-2xl border border-white/[0.07] bg-night-950/50 p-6 sm:p-7', panel && 'mt-8']}>
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-volt-400">Typical scope</p>
          <ul class:list={['mt-5 gap-3.5', panel ? 'grid sm:grid-cols-2' : 'space-y-3.5']}>
            {s.includes.map((t) => <li class="flex gap-3 text-slate-200"><Icon name="Check" class="mt-0.5 h-5 w-5 text-volt-400" />{t}</li>)}
          </ul>
        </div>
      );
      return (
      <section id={s.id} class="card scroll-mt-28 overflow-hidden">
        <div class="grid gap-10 p-7 sm:p-10 lg:grid-cols-12 lg:gap-14 lg:p-14">
          <div class:list={[panel ? 'lg:col-span-7' : 'lg:col-span-7']}>
            <div class="flex items-center gap-4">
              <span class="grid h-14 w-14 place-items-center rounded-2xl border border-volt-400/30 bg-volt-400/10 text-volt-400"><Icon name={s.icon} class="h-7 w-7" /></span>
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400">Service {String(i + 1).padStart(2, '0')}</span>
            </div>
            <h2 class="mt-7 text-3xl font-semibold sm:text-4xl">{s.title}</h2>
            <p class="mt-5 text-lg leading-relaxed text-slate-300">{s.body}</p>
            <p class="mt-6 text-sm text-slate-400"><span class="font-mono text-[11px] uppercase tracking-[0.18em] text-slate-400">Good fit for</span><br/><span class="text-slate-200">{s.goodFor}</span></p>
            {panel && scope}
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={`/contact/?type=${s.id}`} class="btn btn-primary">Request a Quote <Icon name="ArrowRight" class="h-4 w-4" /></a>
              <a href={SITE.phoneHref} class="btn btn-ghost"><Icon name="Phone" class="h-4 w-4 text-volt-400" />{SITE.phone}</a>
            </div>
          </div>
          <div class="lg:col-span-5">
            {panel ? (
              <div class="relative grid grid-cols-2 items-end gap-5 rounded-2xl border border-white/[0.07] bg-night-950/50 p-5 sm:p-6">
                <div class="pointer-events-none absolute inset-12 rounded-full bg-volt-400/10 blur-3xl"></div>
                <figure class="relative"><Panelboard uid="svc-a" door={false} class="h-auto w-full" title="Illustration of a commercial bolt-on panelboard with deadfront installed, main breaker at top and two columns of bolt-on branch breakers" /><figcaption class="mt-3 text-center font-mono text-[10px] uppercase tracking-[0.16em] text-slate-400">Deadfront</figcaption></figure>
                <figure class="relative"><Panelboard uid="svc-b" mode="interior" door={false} class="h-auto w-full" title="Illustration of a commercial bolt-on panelboard interior showing copper bus and bolt-on breakers" /><figcaption class="mt-3 text-center font-mono text-[10px] uppercase tracking-[0.16em] text-slate-400">Interior · bus</figcaption></figure>
                <p class="relative col-span-2 text-xs leading-relaxed text-slate-400">Illustrations of a commercial bolt-on lighting &amp; appliance panelboard.<br/><span class="placeholder-text">[Replace with photos of Sound Electric NW panel installs]</span></p>
              </div>
            ) : scope}
          </div>
        </div>
      </section>
      );
    })}
  </div>

  <section class="container-x mt-16">
    <div class="rounded-2xl border border-white/[0.08] bg-white/[0.02] p-7 text-sm text-slate-400 sm:p-8">
      <p><span class="font-semibold text-white">Not sure which service fits?</span> Many commercial projects combine several of these, like a TI that needs a panel upgrade, or an LED retrofit paired with EV charging. Tell us what you are trying to accomplish and we will scope it together.</p>
    </div>
  </section>

  <FinalCTA />
</Base>
